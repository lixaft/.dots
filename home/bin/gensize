#!/usr/bin/env python
from __future__ import annotations

import argparse
import os
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from collections.abc import Sequence


def _parse_size(size: str) -> int:
    size = size.casefold()

    try:
        return int(size)
    except ValueError:
        pass

    try:
        if size.endswith("gb"):
            return int(size[:-2]) * 1024**3
        if size.endswith("mb"):
            return int(size[:-2]) * 1024**2
        if size.endswith("kb"):
            return int(size[:-2]) * 1024**1
        if size.endswith("b"):
            return int(size[:-1])
    except ValueError:
        pass

    msg = f"could not parse: {size!r}"
    raise ValueError(msg)


def _parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.register("type", "size", _parse_size)

    parser.add_argument("size", type="size")
    parser.add_argument("path")
    return parser.parse_args(argv)


def _do(size: int, path: str) -> None:
    with open(path, "wb") as f:
        while size > 0:
            chunk = min(size, 1024**2)
            f.write(os.urandom(chunk))
            size -= chunk


def main(argv: Sequence[str] | None = None) -> int:
    args = _parse_args(argv)
    _do(args.size, args.path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
